{
  "appId": "com.bnb.business.network",
  "appName": "BNB BUSINESS Network Bangladesh",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "ais-dev-lcpzj4h5d5mm2it3dw6e57-969303088573.asia-southeast1.run.app",
      "ais-pre-lcpzj4h5d5mm2it3dw6e57-969303088573.asia-southeast1.run.app",
      "*.run.app",
      "api.zinipay.com",
      "sandbox.zinipay.com",
      "*.zinipay.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#005a36",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#005a36",
      "overlaysWebView": false
    },
    "NavigationBar": {
      "backgroundColor": "#005a36",
      "style": "DARK"
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}