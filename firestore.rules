rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for hardened security
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Agent Locations: public read, owner write
    match /agentLocations/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection: Users can read and update their own profile, but CANNOT modify balance, walletBalance, role, or memberId
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance', 'walletBalance', 'role', 'memberId']);
      allow delete: if false; // Permanent lifetime protection
    }

    // Transactions, Payment Orders, and Gateway logs can ONLY be written by Admin SDK (Server)
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow write: if false; // Server Admin SDK bypasses rules
    }

    match /payment_orders/{orderId} {
      allow read: if isSignedIn();
      allow write: if false; // Server Admin SDK bypasses rules
    }

    // Global Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
